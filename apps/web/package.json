{
  "name": "@momento/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:openapi": "node --import tsx ../../scripts/generate-openapi.ts",
    "predev": "npm run generate:openapi",
    "prebuild": "npm run generate:openapi",
    "pretypecheck": "npm run generate:openapi",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@momento/protocol": "0.1.0",
    "fumadocs-core": "^16.15.14",
    "fumadocs-mdx": "^15.4.4",
    "fumadocs-openapi": "^12.0.2",
    "fumadocs-ui": "^16.15.14",
    "katex": "^0.18.9",
    "next": "^16.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.3.3"
  }
}
